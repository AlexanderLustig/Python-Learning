import csv

def get_highest_scores(filename):
    with open(filename, 'r') as file:
        reader = csv.reader(file)
        # 1. Grab the header (Name, Math, Science, History)
        headers = next(reader) 
        subjects = headers[1:]  # Everything after 'Name'
        
        # 2. Setup a dictionary to track the winners
        # Format: { 'Subject': [top_student, top_score] }
        winners = {subject: ["", 0] for subject in subjects}
        
        # 3. Loop through each student row
        for row in reader:
            name = row[0]
            scores = row[1:]
            
            for i, score_str in enumerate(scores):
                score = int(score_str)
                subject = subjects[i]
                
                # Check if this student has the highest score so far
                if score > winners[subject][1]:
                    winners[subject] = [name, score]
        
        # 4. Display the results
        print("Highest Scores:")
        for subject in subjects:
            name, score = winners[subject]
            print(f"{subject}: {name} ({score})")

# Run the function
get_highest_scores('scores.txt')
